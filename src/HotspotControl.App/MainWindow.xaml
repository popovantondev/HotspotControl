<Window x:Class="HotspotControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hotspot Control" Icon="Assets/Hotspot.ico" Width="480" Height="820" WindowStyle="None" ResizeMode="NoResize" MinWidth="440" MinHeight="600" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#E9F7FF" Loaded="OnLoaded" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome><Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#152D45"/><GradientStop Color="#0D4358" Offset="0.65"/><GradientStop Color="#087C8C" Offset="1"/></LinearGradientBrush></Window.Background>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#082C3D"/><Setter Property="Background" Value="#59E7DA"/><Setter Property="Padding" Value="24,13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#91FFF0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
   <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#D6EBF4"/><Setter Property="Background" Value="Transparent"/><Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionSurface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#356077"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionSurface" Property="BorderBrush" Value="#79F1E2"/><Setter TargetName="CaptionSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style></Window.Resources>
  <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="12,4,8,4">
   <Image Source="Assets/Hotspot.ico" Width="20" Height="20" HorizontalAlignment="Left" IsHitTestVisible="False"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimieren" AutomationProperties.Name="Minimieren"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M0,5 L12,5"/></Button>
    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="Schließen" AutomationProperties.Name="Schließen"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M1,1 L11,11 M11,1 L1,11"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="28,12,28,26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="Hotspot Control" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Deine Verbindung. Auf einen Blick." Foreground="#A7C8D7" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#24495D" CornerRadius="9" Padding="10,6" Margin="12,0,0,0"><TextBlock Text="WLAN" Foreground="#79F1E2" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
   <Viewbox x:Name="SceneHost" Grid.Row="1" Stretch="Uniform" MaxHeight="370" Margin="0,8,0,8"/>
   <Border Grid.Row="2" Background="#DB112C43" BorderBrush="#396074" BorderThickness="1" CornerRadius="20" Padding="24">
    <StackPanel>
     <TextBlock Text="MOBILER HOTSPOT" FontSize="11" Foreground="#9BBCCD"/>
     <TextBlock x:Name="StatusText" Text="Wird abgefragt …" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,20" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Verbundene Geräte" VerticalAlignment="Center" Foreground="#C0D9E4"/><TextBlock x:Name="ClientsText" Grid.Column="1" Text="—" FontSize="26" FontWeight="SemiBold"/></Grid>
     <Border Height="1" Background="#365468" Margin="0,18,0,14"/>
     <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#A8C5D4" FontSize="12"/>
    </StackPanel>
   </Border>
   <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdatedText" Text="Noch nicht aktualisiert" VerticalAlignment="Center" Foreground="#C1DFE7" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"/><Button x:Name="RefreshButton" Grid.Column="1" Content="_Aktualisieren" Click="OnRefresh" AutomationProperties.Name="Status aktualisieren"/></Grid>
   <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="DevicesButton" Content="Geräte" Click="OnDevices" Padding="12,10" Background="#A2DFE4"/>
    <Button x:Name="SettingsButton" Grid.Column="2" Content="Einstellungen" Click="OnSettings" Padding="12,10" Background="#A2DFE4"/>
   </Grid>  </Grid>
 </Grid>
</Window>
